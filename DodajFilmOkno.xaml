<Window x:Class="Media_Player.DodajFilmOkno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Media_Player"
        mc:Ignorable="d"
        Title="DodajFilmOkno" MinHeight="500" MinWidth="550" SizeToContent="WidthAndHeight">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label Content="Add video" HorizontalAlignment="Center" FontSize="18" Margin="0,10"/>
        <Grid Margin="20" Width="392" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Name:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2" FontSize="11"/>
            <TextBox Grid.Row="0" Grid.Column="1" TextChanged="NameTextBox_TextChanged" Margin="10,6,-69,6" Grid.ColumnSpan="2"/>

            <Label Grid.Row="1" Grid.Column="0" Content="File path:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2" FontSize="11"/>
            <TextBox Grid.Row="1" Grid.Column="1" TextChanged="FilePathTextBox_TextChanged" Margin="10,6,-30,5" Grid.ColumnSpan="2"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Button" Margin="55,6,0,5" HorizontalAlignment="Left" Width="34"/>

            <Label Grid.Row="2" Grid.Column="0" Content="File type:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2" FontSize="11"/>
            <TextBox Grid.Row="2" Grid.Column="1" TextChanged="FileTypeTextBox_TextChanged" Margin="10,6,-69,6" Grid.ColumnSpan="2"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Last modified:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2" FontSize="11"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Thumbnail path:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2" FontSize="11"/>
            <TextBox Grid.Row="4" Grid.Column="1" TextChanged="ThumbnailPathTextBox_TextChanged" Margin="10,6,-30,8" Grid.ColumnSpan="2"/>

            <Image Grid.Row="5" Grid.Column="1" Height="100" Width="160" />

            <Button Grid.Row="6" Grid.Column="1" Content="Button"/>
            <DatePicker Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="3" VerticalAlignment="Center" Width="279" Grid.ColumnSpan="2"/>
        </Grid>
    </StackPanel>
</Window>
